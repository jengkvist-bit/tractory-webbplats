---
// Grundmallen som alla sidor använder: <head>, sidhuvud och sidfot.
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/500.css';
import '../styles/global.css';

interface Props { titel: string; beskrivning?: string; bild?: string; schema?: object[] }
const { titel, beskrivning = '', bild = '/bilder/Tractory-Some.webp', schema = [] } = Astro.props;
// Strukturerad data (schema.org) som hjälper Google att förstå sajten.
const webbplats = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Tractory', url: 'https://www.tractory.se' };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sökväg = Astro.url.pathname.replace(base, '');
const meny = [
  { text: 'Tjänster', href: '/tjanster' },
  { text: 'Om', href: '/om-oss' },
  { text: 'Kontakt', href: '/kontakt' },
  { text: 'Blogg', href: '/blogg' },
];
// Webbanalys med GoatCounter: räknar besök utan cookies, så ingen cookie-banner behövs.
// Byt namnet om du valde ett annat när du skapade kontot på goatcounter.com.
const goatcounter = 'tractory';
// Räkna bara besök på den riktiga sajten, inte på testadressen.
const räknaBesök = Astro.site?.hostname === 'www.tractory.se';
const aktiv = (href: string) => sökväg === href || sökväg.startsWith(href + '/');
// Säkerhetsregel (Content Security Policy): webbläsaren får bara köra kod och visa filer från sajten själv.
// Enda undantaget är att besöksräkningen får skicka en signal till GoatCounter.
// Om något slutar fungera efter att du lagt till en tjänst från en annan sajt (t.ex. en inbäddad video) är det den här raden som behöver ändras.
const räknare = `https://${goatcounter}.goatcounter.com`;
const säkerhetsregel = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self'",
  `img-src 'self' data: ${räknare}`,
  "font-src 'self'",
  `connect-src 'self' ${räknare}`,
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  'upgrade-insecure-requests',
].join('; ');
// Strukturerad data läggs i <script>-taggar. "<" skrivs om så att text i den aldrig kan avsluta taggen i förtid.
const somJson = (s: object) => JSON.stringify(s).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="sv">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Content-Security-Policy" content={säkerhetsregel} />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <title>{titel}</title>
  <meta name="description" content={beskrivning} />
  <meta property="og:title" content={titel} />
  <meta property="og:description" content={beskrivning} />
  <meta property="og:image" content={new URL(base + bild, Astro.site)} />
  <!-- Bevisar för Google Search Console att sajten är Jonas. -->
  <meta name="google-site-verification" content="CEOBSqHg8uPvgsAeRM25r62H6VNamVnLk6cs5tBOjak" />
  <link rel="icon" href={base + '/bilder/favicon.webp'} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  {[webbplats, ...schema].map((s) => <script type="application/ld+json" set:html={somJson(s)} />)}
  {räknaBesök && (
    <script is:inline async data-goatcounter={`${räknare}/count`} src={base + '/js/goatcounter.js'}></script>
  )}
</head>
<body>
  <a class="hoppa" href="#innehall">Gå vidare till innehåll</a>
  <header class="sidhuvud">
    <a class="logga" href={base + '/'}>Tractory</a>
    <nav aria-label="Huvudmeny">
      <ul>
        {meny.map((m) => (
          <li><a href={base + m.href} aria-current={aktiv(m.href) ? 'page' : undefined}>{m.text}</a></li>
        ))}
      </ul>
    </nav>
  </header>
  <main id="innehall">
    <slot />
  </main>
  <footer class="sidfot">
    <div class="sidfot-inre">
      <div>
        <p class="sidfot-namn">Tractory AB</p>
        <p>Copyright {new Date().getFullYear()}</p>
        <p class="sidfot-kakor">Inga cookies här. Varsågod, bara att läsa.</p>
      </div>
      <div>
        <p><a href="mailto:jonas@tractory.se">Skicka ett mejl</a></p>
      </div>
    </div>
  </footer>
</body>
</html>
