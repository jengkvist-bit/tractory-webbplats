---
import { url } from '../lib/url';
// Startsidan
import Bas from '../layouts/Bas.astro';
const tjanster = [
  { titel: 'Tjänstedesign', text: 'Att skapa och optimera tjänster genom att noggrant analysera och förbättra kundens hela upplevelse från första kontakt till slutlig användning.', href: '/tjanstedesign', lank: 'Mer om tjänstedesign' },
  { titel: 'UX-design', text: 'Att skapa intuitiva och engagerande digitala upplevelser genom att fokusera på användarens behov och beteenden.', href: '/ux-design', lank: 'Mer om UX-design' },
  { titel: 'UX research', text: 'Att systematiskt samla in och analysera användardata för att förstå användarnas behov, beteenden och problem.', href: '/ux-research', lank: 'Mer om UX research' },
];
---
<Bas
  titel="Tjänstedesign & UX-konsult i Stockholm — Tractory"
  beskrivning="Tractory hjälper organisationer i Stockholm med tjänstedesign och UX research, etiskt och evidensbaserat."
  bild="/bilder/Tractory-Some-2.webp"
  schema={[{
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': 'https://www.tractory.se/#foretag',
    name: 'Tractory AB',
    url: 'https://www.tractory.se',
    email: 'jonas@tractory.se',
    logo: 'https://www.tractory.se/bilder/favicon.webp',
    description: 'Tjänstedesign, med UX research och UX-design som komplement, för organisationer i Stockholm.',
    address: { '@type': 'PostalAddress', addressLocality: 'Stockholm', addressCountry: 'SE' },
    areaServed: { '@type': 'City', name: 'Stockholm' },
    knowsAbout: ['Tjänstedesign', 'Service design', 'UX research', 'UX-design', 'Digital etik'],
    founder: { '@type': 'Person', '@id': 'https://www.tractory.se/om-oss#jonas', name: 'Jonas Engkvist', url: 'https://www.tractory.se/om-oss' },
  }]}
>
  <section class="hero">
    <h1>Tjänstedesign och UX för organisationer som misstänker att de kan göra bättre ifrån sig digitalt.</h1>
    <p>Det kan de nästan alltid. Tractory hjälper organisationer i offentlig och privat sektor att förstå varför, och vad de ska göra åt det.</p>
    <a class="knapp" href={url("/kontakt")}>Boka ett samtal</a>
  </section>

  <section class="ljus">
    <h2>Design, innovation, etik</h2>
    <p>Tractory levererar tjänstedesign, UX-design och digital strategi, med fokus på att skapa innovativa, etiskt ansvarsfulla och hållbara lösningar.</p>
    <a class="knapp" href={url("/om-oss")}>Om mig</a>
  </section>

  <section class="innehall">
    <h2>Tjänster</h2>
    <div class="kort-rad">
      {tjanster.map((t) => (
        <div class="kort">
          <h3>{t.titel}</h3>
          <p>{t.text}</p>
          <a class="knapp kontur" href={url(t.href)}>{t.lank}</a>
        </div>
      ))}
    </div>
    <a class="knapp" href={url("/tjanster")}>Alla tjänster</a>
  </section>
</Bas>
